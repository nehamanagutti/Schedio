# Browser development uses Vite's /api proxy, so this is optional locally.
# For Android devices and production builds, set this to your public HTTPS API.
# Do not include a trailing slash.
VITE_API_URL=https://your-api.example.com/api

# Firebase Web app configuration. Copy the values from Firebase Console >
# Project settings > Your apps > Web app. Never hard-code these in source.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
