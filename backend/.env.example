PORT=4000
JWT_SECRET=replace-with-a-long-random-secret

# MongoDB database used for Firebase-authenticated user records.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/schedio

# Brevo SMTP email delivery. Configure the same variables in Render.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-username
SMTP_PASS=your-brevo-smtp-key
# This sender address must be verified in Brevo.
SMTP_FROM=Sushantkhemalapure@gmail.com

# Comma-separated browser app URLs allowed to call this API.
# Example: https://your-app.vercel.app
FRONTEND_URLS=

# Firebase Admin service account credentials. Create these in Firebase Console
# > Project settings > Service accounts. Preserve literal \n characters in the
# private key when storing it in a hosting provider's environment settings.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
