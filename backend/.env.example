PORT=4000
JWT_SECRET=replace-with-a-long-random-secret

# Brevo SMTP email delivery. Create an SMTP key in Brevo, then configure these
# same variables in the Render service Environment page.
BREVO_SMTP_USER=your-brevo-login-email@example.com
BREVO_SMTP_KEY=your-brevo-smtp-key
# This must be a sender address verified in Brevo. If omitted, BREVO_SMTP_USER
# is used as the sender address.
EMAIL_FROM=no-reply@your-verified-domain.example

# Comma-separated browser app URLs allowed to call this API.
# Example: https://your-app.vercel.app
FRONTEND_URLS=
