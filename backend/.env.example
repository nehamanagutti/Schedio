PORT=4000
JWT_SECRET=replace-with-a-long-random-secret

# Gmail account used to send signup verification codes. Use a Gmail App Password,
# not the normal Gmail password. Leave these unset only for local OTP testing.
GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Comma-separated browser app URLs allowed to call this API.
# Example: https://your-app.vercel.app
FRONTEND_URLS=
