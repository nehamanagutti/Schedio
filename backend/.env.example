PORT=4000
JWT_SECRET=replace-with-a-long-random-secret

# Production email delivery (recommended for Render):
# Create a Resend API key and verify the domain used by EMAIL_FROM.
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=no-reply@your-verified-domain.example

# Optional SMTP fallback for local development or a provider that permits SMTP.
# EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=your-smtp-password-or-gmail-app-password

# Comma-separated browser app URLs allowed to call this API.
# Example: https://your-app.vercel.app
FRONTEND_URLS=
